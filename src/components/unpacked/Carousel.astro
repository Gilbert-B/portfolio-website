---
// One-at-a-time carousel of Unpacked case studies. Swipe, arrow buttons,
// dots or keyboard arrows move between slides; clicking a slide opens it.
// Without JavaScript it is still a horizontally scrollable, snapping row.
import type { CollectionEntry } from 'astro:content';

interface Props {
  episodes: CollectionEntry<'unpacked'>[];
}
const { episodes } = Astro.props;
---

<div class="carousel" data-carousel>
  <div class="track" tabindex="0" aria-label="Unpacked case studies" role="region">
    {episodes.map((e, i) => (
      <a class="slide" href={`/projects/unpacked/${e.id}/`} aria-label={`${e.data.title} — case study ${i + 1} of ${episodes.length}`}>
        <img src={e.data.video.poster} alt="" width="720" height="1280" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        <div class="info">
          <p class="meta"><span>{e.data.storyId}</span> · {e.data.domain}</p>
          <h3>{e.data.title}</h3>
          <p class="summary">{e.data.summary}</p>
          <dl class="fig">
            {e.data.keyFigures.slice(0, 2).map((f) => (
              <div><dd>{f.value}</dd><dt>{f.label}</dt></div>
            ))}
          </dl>
          <span class="open">Open the case study →</span>
        </div>
      </a>
    ))}
  </div>

  <div class="controls">
    <button type="button" class="nav prev" aria-label="Previous case study">←</button>
    <div class="dots" role="tablist">
      {episodes.map((e, i) => (
        <button type="button" class="dot" aria-label={`Go to ${e.data.title}`} aria-current={i === 0 ? 'true' : undefined}></button>
      ))}
    </div>
    <span class="count"><b>1</b> / {episodes.length}</span>
    <button type="button" class="nav next" aria-label="Next case study">→</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track')!;
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.dot')];
    const count = root.querySelector('.count b')!;
    const prev = root.querySelector<HTMLButtonElement>('.prev')!;
    const next = root.querySelector<HTMLButtonElement>('.next')!;
    let index = 0;

    const go = (i: number) => {
      index = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[index].offsetLeft - track.offsetLeft, behavior: 'smooth' });
    };
    const update = () => {
      // Current slide = the one whose left edge is closest to the track's left edge.
      const x = track.scrollLeft;
      let best = 0;
      slides.forEach((s, i) => {
        if (Math.abs(s.offsetLeft - track.offsetLeft - x) < Math.abs(slides[best].offsetLeft - track.offsetLeft - x)) best = i;
      });
      index = best;
      dots.forEach((d, i) => d.toggleAttribute('aria-current', i === best));
      slides.forEach((s, i) => s.classList.toggle('active', i === best));
      count.textContent = String(best + 1);
      prev.disabled = best === 0;
      next.disabled = best === slides.length - 1;
    };

    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
    });
    let t: number;
    track.addEventListener('scroll', () => { cancelAnimationFrame(t); t = requestAnimationFrame(update); }, { passive: true });
    update();
  });
</script>

<style>
  .carousel { position: relative; }
  .track {
    display: flex; align-items: flex-start; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-behavior: smooth; scrollbar-width: none; padding: 0.25rem 0 0.5rem;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar { display: none; }
  @media (prefers-reduced-motion: reduce) { .track { scroll-behavior: auto; } }

  .slide {
    flex: 0 0 100%; scroll-snap-align: start;
    display: grid; grid-template-columns: minmax(8rem, 38%) 1fr; gap: 1.1rem; align-items: center;
    padding: 1rem; border-radius: calc(var(--radius) * 1.3); text-decoration: none; color: var(--gilb-cream);
    background: radial-gradient(120% 90% at 0% 0%, var(--gilb-teal) 0%, var(--gilb-navy) 55%, #050f1d 100%);
    border: 1px solid rgba(246, 240, 228, 0.12);
    transition: border-color 0.3s, opacity 0.4s, transform 0.4s var(--ease);
  }
  @media (min-width: 48rem) {
    .slide { flex-basis: 86%; grid-template-columns: 15rem 1fr; gap: 2.25rem; padding: 1.5rem 2rem 1.5rem 1.5rem; }
    .slide:not(.active) { opacity: 0.45; transform: scale(0.97); }
  }
  .slide:hover { border-color: rgba(227, 166, 64, 0.55); }
  .slide:hover .open { text-decoration: underline; }

  img { width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: cover; border-radius: 12px; box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.8); }
  .meta { margin: 0 0 0.5rem; font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: #b8bfc8; }
  .meta span { color: var(--gilb-gold); font-weight: 600; }
  h3 { margin: 0 0 0.5rem; font-size: clamp(1.25rem, 3.2vw, 2rem); color: var(--gilb-cream); }
  .summary { margin: 0; color: #d9dde3; font-size: 0.95rem; }
  .fig { display: none; margin: 1.25rem 0 0; gap: 1rem; grid-template-columns: 1fr 1fr; }
  .fig div { display: flex; flex-direction: column; border-top: 2px solid var(--gilb-gold); padding-top: 0.5rem; }
  .fig dd { margin: 0; font-family: var(--display); font-size: 1.35rem; font-weight: 700; color: var(--gilb-cream); }
  .fig dt { font-size: 0.8rem; color: #b8bfc8; }
  @media (min-width: 48rem) { .fig { display: grid; } .summary { font-size: 1.05rem; } }
  .open { display: inline-block; margin-top: 1rem; color: var(--gilb-gold); font-weight: 600; font-size: 0.95rem; }
  @media (max-width: 47.99rem) {
    .slide { flex-basis: 88%; grid-template-columns: 6.5rem 1fr; gap: 0.9rem; padding: 0.85rem; align-items: start; }
    .summary { font-size: 0.875rem; }
    .open { margin-top: 0.6rem; font-size: 0.875rem; }
  }

  .controls { display: flex; align-items: center; justify-content: center; gap: 0.9rem; margin-top: 1rem; }
  .nav {
    width: 2.75rem; height: 2.75rem; border-radius: 50%; cursor: pointer;
    border: 1px solid var(--border-strong); background: var(--surface); color: var(--text); font-size: 1.1rem;
    transition: border-color 0.2s, color 0.2s, opacity 0.2s;
  }
  .nav:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
  .nav:disabled { opacity: 0.35; cursor: default; }
  .dots { display: flex; gap: 0.45rem; }
  .dot { width: 0.6rem; height: 0.6rem; padding: 0; border-radius: 999px; border: 0; cursor: pointer; background: rgba(255, 255, 255, 0.2); transition: width 0.3s var(--ease), background 0.3s; }
  .dot[aria-current] { width: 1.8rem; background: var(--accent); }
  .count { font-size: 0.85rem; color: var(--muted); font-variant-numeric: tabular-nums; min-width: 2.5rem; text-align: center; }
  .count b { color: var(--text); }
</style>
