---
import { SITE } from '../site';
const year = new Date().getFullYear();
---

<footer>
  <div class="container row">
    <p>© {year} {SITE.name} · {SITE.location}</p>
    <p>
      <a href={`mailto:${SITE.email}`}>Email</a>
      {SITE.linkedin && <> · <a href={SITE.linkedin} rel="me">LinkedIn</a></>}
    </p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border); color: var(--muted); font-size: 0.925rem; }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1.5rem; padding-top: 1.5rem; padding-bottom: 1.5rem; }
  p { margin: 0; }
</style>
