---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const steps = [
  { title: 'You send a short note', text: 'What your business does, the systems you use, and the report or decision you want to improve.' },
  { title: 'We have a short call', text: 'We agree the question, look at the data you already have, and check it is a good fit.' },
  { title: 'You get a clear proposal', text: 'Scope, deliverables and timeline in plain language, before any work starts.' },
];
---

<Base title="Contact" description={`Get in touch with ${SITE.name} about dashboards, reporting and data projects.`}>
  <p class="eyebrow" data-reveal>Contact</p>
  <h1 data-reveal style="--d:80ms">Let's talk about <span class="hl">your numbers.</span></h1>
  <p class="lead" data-reveal style="--d:160ms">
    Have a reporting problem or a data question? Send a short note about your business and
    what you'd like to improve — I'll reply to arrange a conversation.
  </p>

  <div class="split">
    <div>
      <div class="card glow" data-reveal style="--d:240ms">
        <p class="label">Email</p>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        {SITE.linkedin && (
          <>
            <p class="label">LinkedIn</p>
            <p><a href={SITE.linkedin} rel="me">View profile →</a></p>
          </>
        )}
        <p class="where">Based in {SITE.location} · working with clients locally and remotely</p>
      </div>

      <h2 data-reveal>What happens next</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li data-reveal style={`--d:${i * 100}ms`}>
            <span class="n">{i + 1}</span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
    </div>

    <aside data-reveal style="--d:200ms">
      <div class="panel">
        <h2>Helpful to include</h2>
        <ul class="facts">
          <li><b>Your business</b><span>What it does and roughly how big it is</span></li>
          <li><b>Your systems</b><span>e.g. Excel, an ERP, Power BI</span></li>
          <li><b>The goal</b><span>The decision or report you want to improve</span></li>
        </ul>
      </div>
    </aside>
  </div>
</Base>

<style>
  .split { margin-top: 2rem; }
  .card { margin: 0; }
  .card p { margin: 0; }
  .label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; margin-top: 1rem !important; }
  .label:first-child { margin-top: 0 !important; }
  .card a { font-size: clamp(1.1rem, 3.4vw, 1.5rem); font-weight: 600; font-family: var(--display); word-break: break-word; }
  .where { margin-top: 1.25rem !important; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.9rem; }
  .glow { padding: 1.75rem; border-color: rgba(227, 166, 64, 0.35); box-shadow: 0 0 60px -20px rgba(227, 166, 64, 0.35); }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
  .steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; align-items: start; }
  .n {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%;
    font-family: var(--display); font-weight: 700; color: var(--accent);
    border: 1px solid rgba(227, 166, 64, 0.45); background: var(--accent-soft);
  }
  .steps h3 { margin: 0.35rem 0 0.2rem; font-size: 1.1rem; }
  .steps p { margin: 0; color: var(--muted); }
</style>
