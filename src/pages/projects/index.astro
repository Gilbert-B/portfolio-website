---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import Showcase from '../../components/unpacked/Showcase.astro';
import SuiteShowcase from '../../components/projects/SuiteShowcase.astro';

// Featured analytics-engineering projects get a full showcase; any others appear as cards below it.
const FEATURED = ['workforce-intelligence-suite'];

const projects = (await getCollection('projects'))
  .filter((p) => !FEATURED.includes(p.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Projects" description="Analytics and analytics-engineering projects built on realistic business problems.">
  <p class="eyebrow" data-reveal>Projects</p>
  <h1 data-reveal style="--d:80ms">Real data. <span class="hl">Checked work.</span></h1>
  <p class="lead" data-reveal style="--d:160ms">
    Data research on real public data, and analytics engineering builds on realistic synthetic
    data. Each case study explains the question, the approach, the decisions and the results —
    including what the data can't show.
  </p>

  <div data-reveal style="--d:240ms"><Showcase /></div>

  <h2>Analytics engineering projects</h2>
  <div data-reveal><SuiteShowcase /></div>
  {projects.length > 0 && (
    <div class="grid more">
      {projects.map((p) => (
        <a class="card link" href={`/projects/${p.id}/`}>
          <p class="eyebrow">{p.data.status === 'complete' ? 'Case study' : 'In progress'}</p>
          <h3>{p.data.title}</h3>
          <p>{p.data.summary}</p>
          <ul class="tags">{p.data.tools.map((t) => <li>{t}</li>)}</ul>
        </a>
      ))}
    </div>
  )}
</Base>

<style>
  .link { text-decoration: none; color: inherit; display: block; }
  .link:hover { border-color: var(--accent); }
  .link .tags { margin-top: 1rem; }
  .more { margin-top: 1.5rem; }
</style>
