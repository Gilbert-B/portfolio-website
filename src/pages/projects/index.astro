---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import FeaturedCard from '../../components/unpacked/FeaturedCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Projects" description="Analytics and analytics-engineering projects built on realistic business problems.">
  <p class="eyebrow" data-reveal>Projects</p>
  <h1 data-reveal style="--d:80ms">Real data. <span class="hl">Checked work.</span></h1>
  <p class="lead" data-reveal style="--d:160ms">
    Data research and analytics work on real public data. Each case study explains the
    question, the approach, the decisions and the results — including what the data can't show.
  </p>

  <div data-reveal style="--d:240ms"><FeaturedCard /></div>

  <h2>Analytics engineering projects</h2>
  {projects.length === 0 ? (
    <p class="notice">
      Data modelling and pipeline projects are in progress. They will appear here as each one is
      completed and checked — no placeholders.
    </p>
  ) : (
    <div class="grid">
      {projects.map((p) => (
        <a class="card link" href={`/projects/${p.id}/`}>
          <p class="eyebrow">{p.data.status === 'complete' ? 'Case study' : 'In progress'}</p>
          <h3>{p.data.title}</h3>
          <p>{p.data.summary}</p>
          <ul class="tags">{p.data.tools.map((t) => <li>{t}</li>)}</ul>
        </a>
      ))}
    </div>
  )}
</Base>

<style>
  .link { text-decoration: none; color: inherit; display: block; }
  .link:hover { border-color: var(--accent); }
  .link .tags { margin-top: 1rem; }
</style>
