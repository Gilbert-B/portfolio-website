---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { CV } from '../data/cv';

// PDF generated from this page's print layout (see README: "Updating the CV PDF").
const PDF = '/downloads/Gilbert-Botchway-CV.pdf';
const siteHost = new URL(Astro.site ?? 'https://example.com').host;
const linkedinShort = SITE.linkedin.replace(/^https?:\/\/(www\.)?/, '');
---

<Base title="CV" description={`${SITE.name} — CV: data analyst experience, skills, education and certifications.`}>
  <header class="cv-head">
    <p class="eyebrow" data-reveal>Curriculum vitae</p>
    <h1 data-reveal style="--d:80ms">{SITE.name}</h1>
    <p class="headline" data-reveal style="--d:140ms">{CV.headline}</p>
    <p class="contact" data-reveal style="--d:200ms">
      <span>{SITE.location}</span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      {SITE.linkedin && <a href={SITE.linkedin} rel="me"><span class="screen">LinkedIn</span><span class="print">{linkedinShort}</span></a>}
      <a class="print" href={Astro.site?.toString()}>{siteHost}</a>
    </p>
    <div class="actions screen" data-reveal style="--d:260ms">
      <a class="btn" href={PDF} download>Download CV (PDF) ↓</a>
    </div>
  </header>

  <section class="summary card" data-reveal>
    <h2>Professional summary</h2>
    <p>{CV.summary}</p>
  </section>

  <h2 data-reveal>Experience</h2>
  <ol class="timeline">
    {CV.experience.map((job) => (
      <li data-reveal>
        <div class="when">{job.period}</div>
        <div class="what">
          <h3>{job.role}</h3>
          <p class="org">{job.org} · {job.place}</p>
          <ul>{job.points.map((p) => <li>{p}</li>)}</ul>
        </div>
      </li>
    ))}
  </ol>

  <h2 data-reveal>Core skills</h2>
  <div class="skills">
    {CV.skills.map((s, i) => (
      <div class="card" data-reveal style={`--d:${(i % 2) * 90}ms`}>
        <h3>{s.area}</h3>
        <p>{s.items}</p>
      </div>
    ))}
  </div>

  <div class="two">
    <section data-reveal>
      <h2>Education</h2>
      <ul class="plain">
        {CV.education.map((e) => (
          <li><strong>{e.title}</strong><span>{e.where}{e.year && ` · ${e.year}`}</span></li>
        ))}
      </ul>
    </section>
    <section data-reveal>
      <h2>Certifications</h2>
      <ul class="plain">
        {CV.certifications.map((c) => (
          <li><strong>{c.title}</strong><span>{c.where}</span></li>
        ))}
      </ul>
    </section>
  </div>

  <p class="note screen"><a class="btn secondary" href={PDF} download>Download CV (PDF) ↓</a></p>
</Base>

<style>
  .cv-head { padding-bottom: 0.5rem; }
  .cv-head h1 { margin-bottom: 0.4rem; }
  .headline { margin: 0; font-size: 1.15rem; color: var(--accent); font-weight: 600; }
  .contact { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; margin: 1rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .summary { margin-top: 2rem; }
  .summary h2 { margin: 0 0 0.6rem; font-size: 1.2rem; }
  .summary p { color: var(--text); font-size: 1.05rem; max-width: 52rem; }

  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline > li { display: grid; gap: 0.35rem 2rem; padding: 1.5rem 0 1.5rem 1.4rem; border-left: 2px solid var(--border-strong); position: relative; }
  .timeline > li::before { content: ''; position: absolute; left: -7px; top: 1.85rem; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px rgba(227, 166, 64, 0.2); }
  @media (min-width: 48rem) {
    .timeline > li { grid-template-columns: 11rem 1fr; padding-left: 2rem; }
  }
  .when { font-size: 0.85rem; color: var(--accent); font-weight: 600; padding-top: 0.2rem; }
  .what h3 { margin: 0 0 0.2rem; font-size: 1.2rem; }
  .org { margin: 0 0 0.75rem; color: var(--muted); }
  .what ul { margin: 0; padding-left: 1.1rem; color: var(--muted); }
  .what ul li { margin-bottom: 0.45rem; }
  .what ul li::marker { color: var(--accent); }

  .skills { display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .skills { grid-template-columns: 1fr 1fr; } }
  .skills h3 { color: var(--accent); font-size: 1rem; text-transform: uppercase; letter-spacing: 0.08em; }

  .two { display: grid; gap: 0 3rem; }
  @media (min-width: 48rem) { .two { grid-template-columns: 1fr 1fr; } }
  .plain { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
  .plain li { display: grid; gap: 0.1rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--border); }
  .plain span { color: var(--muted); font-size: 0.95rem; }
  .note { margin-top: 3rem; }
  .print { display: none; }

  /* Print / PDF layout: light, A4, compact. The PDF download is made from this. */
  @page { size: A4; margin: 13mm 14mm; }
  @media print {
    :global(html), :global(body) { background: #fff !important; color: #16191d !important; font-size: 9.6pt; line-height: 1.42; }
    :global(body::before) { display: none !important; }
    :global(body > header), :global(body > footer) { display: none !important; }
    :global(main) { padding: 0 !important; }
    :global(.container) { max-width: none !important; padding: 0 !important; }
    :global([data-reveal]) { opacity: 1 !important; transform: none !important; }
    .screen { display: none !important; }
    .print { display: inline !important; }
    a { color: inherit !important; text-decoration: none !important; }
    .eyebrow { display: none; }
    .cv-head { padding: 0 0 6pt; border-bottom: 1.5pt solid #b07a1f; }
    .cv-head h1 { font-size: 22pt; margin: 0 0 2pt; color: #0b1a2d; }
    .headline { font-size: 10.5pt; color: #8a5f12 !important; }
    .contact { margin-top: 4pt; font-size: 9pt; color: #333 !important; gap: 0 12pt; }
    h2 { font-size: 11.5pt !important; margin: 11pt 0 5pt !important; color: #0b1a2d; text-transform: uppercase; letter-spacing: 0.06em; break-after: avoid; }
    h3 { font-size: 10.2pt; color: #0b1a2d; }
    .card { background: none !important; border: 0 !important; box-shadow: none !important; padding: 0 !important; }
    .summary { margin-top: 8pt; }
    .summary h2 { margin-top: 0 !important; }
    .summary p { color: #16191d; font-size: 9.6pt; }
    .timeline > li { grid-template-columns: 30mm 1fr !important; padding: 4pt 0 6pt 0 !important; border-left: 0 !important; break-inside: avoid; gap: 0 5mm !important; }
    .timeline > li::before { display: none; }
    .when { color: #8a5f12 !important; font-size: 8.6pt; padding-top: 1.5pt; }
    .org { color: #444 !important; margin-bottom: 2pt; font-size: 9pt; }
    .what ul { color: #222 !important; padding-left: 10pt; }
    .what ul li { margin-bottom: 1.5pt; }
    .skills { grid-template-columns: 1fr 1fr !important; gap: 4pt 8mm !important; }
    .skills h3 { color: #8a5f12 !important; font-size: 8.6pt; margin-bottom: 1pt; }
    .skills p { color: #222 !important; margin: 0; font-size: 9pt; }
    .two { grid-template-columns: 1fr 1fr !important; gap: 0 8mm !important; break-inside: avoid; }
    .plain { gap: 3pt; }
    .plain li { padding-bottom: 3pt; border-bottom: 0.5pt solid #ddd; font-size: 9pt; }
    .plain span { color: #444 !important; font-size: 8.6pt; }
  }
</style>
