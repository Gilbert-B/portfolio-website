---
import Base from '../layouts/Base.astro';
import { SERVICES } from '../data/services';
---

<Base title="Services" description="Dashboards, reporting automation, data analysis, ERP reporting, data audits and training for small and medium-sized businesses.">
  <p class="eyebrow" data-reveal>Services</p>
  <h1 data-reveal style="--d:80ms">Practical analytics, <span class="hl">built to be used.</span></h1>
  <p class="lead" data-reveal style="--d:160ms">
    Practical analytics work for small and medium-sized businesses — starting in Ghana and
    available remotely. Every engagement starts with a short conversation about the problem
    you want solved.
  </p>

  <div class="list">
    {SERVICES.map((s, i) => (
      <article class="card lift" data-reveal style={`--d:${(i % 2) * 90}ms`}>
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <h2>{s.title}</h2>
        <p>{s.summary}</p>
        <h3>What you get</h3>
        <ul>{s.deliverables.map((d) => <li>{d}</li>)}</ul>
        <p class="fit"><strong>A good fit if:</strong> {s.fit}</p>
      </article>
    ))}
  </div>

  <div class="actions" data-reveal>
    <a class="btn" href="/contact/">Discuss your project</a>
  </div>
</Base>

<style>
  .list { display: grid; gap: 1rem; margin-top: 2rem; }
  @media (min-width: 48rem) { .list { grid-template-columns: 1fr 1fr; } }
  article h2 { margin: 0 0 0.25rem; font-size: 1.25rem; }
  article h3 { margin: 1rem 0 0.25rem; font-size: 0.95rem; }
  article ul { margin: 0; padding-left: 1.2rem; color: var(--muted); }
  .fit { margin-top: 1rem !important; font-size: 0.95rem; }
  .fit strong { color: var(--text); }
  .num { display: block; font-family: var(--display); font-weight: 700; font-size: 0.85rem; color: var(--accent); margin-bottom: 1.25rem; letter-spacing: 0.05em; }
  article li::marker { color: var(--accent); }
  .fit { padding-top: 1rem; border-top: 1px solid var(--border); }
</style>
