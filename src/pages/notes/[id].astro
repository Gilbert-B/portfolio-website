---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', (n) => !n.data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={note.data.title} description={note.data.summary}>
  <article class="prose">
    <p class="muted">{note.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
    <h1>{note.data.title}</h1>
    <Content />
  </article>
</Base>
