---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes', (n) => !n.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Notes" description="Short notes on data analysis, reporting and analytics engineering.">
  <h1>Notes</h1>
  <p class="lead">Short write-ups on data, reporting and what I'm learning in analytics engineering.</p>

  {notes.length === 0 ? (
    <p class="notice">The first notes are on the way.</p>
  ) : (
    <ul class="list">
      {notes.map((n) => (
        <li>
          <a href={`/notes/${n.id}/`}>{n.data.title}</a>
          <span class="muted"> · {n.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
          <p class="muted">{n.data.summary}</p>
        </li>
      ))}
    </ul>
  )}
</Base>

<style>
  .list { list-style: none; padding: 0; }
  .list li { padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .list a { font-weight: 600; font-size: 1.1rem; }
  .list p { margin: 0.25rem 0 0; }
</style>
