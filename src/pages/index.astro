---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { SERVICES } from '../data/services';
import FeaturedCard from '../components/unpacked/FeaturedCard.astro';
import HeroDash from '../components/HeroDash.astro';
import { getEpisodes } from '../data/unpacked';

const episodes = await getEpisodes();
const sectors = new Set(episodes.map((e) => e.data.domain)).size;

const tools = ['Excel', 'Power BI', 'SQL', 'Apache Superset', 'Microsoft Report Builder', 'SAP Business One', 'Microsoft Dynamics', 'Zoho', 'Biz360'];

const method = [
  { n: '01', title: 'Question', text: 'Start with the decision you need to make — not the tool or the dashboard.' },
  { n: '02', title: 'Data', text: 'Find the sources you already have, and check how they are defined and collected.' },
  { n: '03', title: 'Verify', text: 'Reproduce the key numbers and challenge anything that looks too clean.' },
  { n: '04', title: 'Explain', text: 'Deliver clear reports and a plain-language summary your team can act on.' },
];
---

<Base>
  <section class="hero">
    <div class="copy">
      <p class="eyebrow" data-reveal>{SITE.role} · {SITE.location}</p>
      <h1 data-reveal style="--d:80ms">Clear, reliable reporting for <span class="hl">growing businesses.</span></h1>
      <p class="lead" data-reveal style="--d:160ms">
        I help small and medium-sized businesses turn scattered data into dashboards and reports
        they can trust. I have worked with data, business intelligence and ERP systems since {SITE.since}, across IT startups, telecom and fintech.
      </p>
      <div class="actions" data-reveal style="--d:240ms">
        <a class="btn" href="/contact/">Start a conversation →</a>
        <a class="btn secondary" href="/projects/">See my work</a>
      </div>
    </div>
    <HeroDash />
  </section>

  <ul class="proof" data-reveal>
    <li><strong>Since {SITE.since}</strong><span>in data, BI &amp; ERP</span></li>
    <li><strong>3 industries</strong><span>IT startups, telecom, fintech</span></li>
    <li><strong><b data-count={episodes.length}>{episodes.length}</b> case studies</strong><span>across {sectors} sectors, on public data</span></li>
    <li><strong>{tools.length} tools</strong><span>from Excel to SAP Business One</span></li>
  </ul>

  <div class="section-head" data-reveal>
    <div>
      <p class="eyebrow">Services</p>
      <h2>How I can help</h2>
    </div>
    <p class="muted">Practical work on the data you already have. <a href="/services/">All services →</a></p>
  </div>
  <div class="services">
    {SERVICES.map((s, i) => (
      <a class="card svc" href="/services/" data-reveal style={`--d:${(i % 3) * 90}ms`}>
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <h3>{s.title}</h3>
        <p>{s.summary}</p>
      </a>
    ))}
  </div>

  <div class="section-head" data-reveal>
    <div>
      <p class="eyebrow">Featured work</p>
      <h2>Data stories, <span class="hl">unpacked.</span></h2>
    </div>
    <p class="muted">Short, verified investigations into familiar headlines — the same method I bring to business data.</p>
  </div>
  <div data-reveal><FeaturedCard /></div>

  <div class="section-head" data-reveal>
    <div>
      <p class="eyebrow">Method</p>
      <h2>How I work</h2>
    </div>
  </div>
  <ol class="method">
    {method.map((m, i) => (
      <li data-reveal style={`--d:${i * 110}ms`}>
        <span class="step">{m.n}</span>
        <h3>{m.title}</h3>
        <p>{m.text}</p>
      </li>
    ))}
  </ol>

  <div class="section-head" data-reveal>
    <div>
      <p class="eyebrow">Toolkit</p>
      <h2>Tools I work with</h2>
    </div>
  </div>
  <div class="marquee" data-reveal>
    <ul class="track">
      {[...tools, ...tools].map((t, i) => <li aria-hidden={i >= tools.length ? 'true' : undefined}>{t}</li>)}
    </ul>
  </div>

  <section class="building" data-reveal>
    <p class="eyebrow">Currently building</p>
    <p>
      I am expanding into analytics engineering — data modelling, tested data pipelines and
      automated reporting. Those projects will be added to the portfolio as each one is
      completed. <a href="/projects/">See all projects →</a>
    </p>
  </section>
</Base>

<style>
  .hero { display: grid; gap: 2.5rem; align-items: center; padding: 1.5rem 0 1rem; }
  @media (min-width: 60rem) { .hero { grid-template-columns: 1.15fr 1fr; gap: 3.5rem; padding: 3rem 0 2rem; min-height: 72vh; } }
  .hero h1 { font-size: clamp(2.5rem, 6.4vw, 4.4rem); }
  .copy .lead { font-size: 1.2rem; }

  .proof {
    list-style: none; margin: 3rem 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, 1fr);
    border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
  }
  @media (min-width: 48rem) { .proof { grid-template-columns: repeat(4, 1fr); } }
  .proof li { padding: 1.2rem 1.25rem; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); display: grid; gap: 0.15rem; }
  .proof strong { font-family: var(--display); font-size: 1.3rem; font-weight: 700; color: var(--text); }
  .proof strong b { font-weight: inherit; }
  .proof > li > span { font-size: 0.875rem; color: var(--muted); }

  .services { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
  .svc { text-decoration: none; color: inherit; display: block; overflow: hidden; }
  .num { display: block; font-family: var(--display); font-weight: 700; font-size: 0.85rem; color: var(--accent); margin-bottom: 1.6rem; letter-spacing: 0.05em; }
  .svc::after {
    content: ''; position: absolute; inset: auto -30% -60% auto; width: 14rem; height: 14rem; border-radius: 50%;
    background: radial-gradient(circle, rgba(227, 166, 64, 0.16), transparent 70%);
    opacity: 0; transition: opacity 0.4s;
  }
  .svc:hover::after { opacity: 1; }

  .method { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; counter-reset: none; }
  @media (min-width: 48rem) { .method { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; } }
  .method li { position: relative; padding-top: 1.4rem; border-top: 2px solid var(--border-strong); }
  .method li::before { content: ''; position: absolute; top: -2px; left: 0; width: 3rem; height: 2px; background: var(--accent); }
  .step { font-family: var(--display); font-size: 2.6rem; font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 1px rgba(227, 166, 64, 0.7); display: block; margin-bottom: 0.75rem; }
  .method h3 { font-size: 1.25rem; }
  .method p { margin: 0; color: var(--muted); font-size: 0.975rem; }

  .marquee { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .marquee .track { display: flex; gap: 0.75rem; width: max-content; list-style: none; padding: 0.25rem 0; margin: 0; }
  .marquee li {
    white-space: nowrap; padding: 0.65rem 1.2rem; border-radius: 999px;
    border: 1px solid var(--border); background: var(--surface); font-weight: 500;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee .track { animation: scroll 38s linear infinite; }
    .marquee:hover .track { animation-play-state: paused; }
    @keyframes scroll { to { transform: translateX(calc(-50% - 0.375rem)); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee { mask-image: none; }
    .marquee .track { flex-wrap: wrap; width: auto; }
    .marquee li[aria-hidden] { display: none; }
  }

  .building { margin-top: 5rem; padding: 1.75rem; border: 1px dashed var(--border-strong); border-radius: var(--radius); }
  .building .eyebrow { margin-bottom: 0.5rem; }
  .building p:last-child { margin: 0; color: var(--muted); max-width: 46rem; }
</style>
